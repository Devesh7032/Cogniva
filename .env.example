# Cogniva Workspace — Environment Variables Template
# Copy this file to .env or .env.local and populate your own credentials.
# NEVER commit real secret values to Git.

# ============================================================================
# 1. SUPABASE CONFIGURATION (Public / Browser-Safe)
# ============================================================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ============================================================================
# 2. SUPABASE SERVICE ROLE (SERVER-ONLY SECRET — DO NOT PREFIX WITH VITE_)
# ============================================================================
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# 3. GEMINI AI API KEYS (SERVER-SIDE / ROLE-BASED INTEGRATIONS)
# ============================================================================
GEMINI_ADMIN_API_KEY=your_admin_gemini_api_key
GEMINI_FACULTY_API_KEY=your_faculty_gemini_api_key
GEMINI_STUDENT_API_KEY=your_student_gemini_api_key

# Optional Fallback Key for Vite environment
VITE_GEMINI_API_KEY=your_fallback_gemini_api_key
