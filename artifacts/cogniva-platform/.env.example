# Cogniva Platform — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file with real secrets.

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Gemini AI API Keys (per role)
VITE_GEMINI_ADMIN_API_KEY=your_admin_gemini_api_key
VITE_GEMINI_FACULTY_API_KEY=your_faculty_gemini_api_key
VITE_GEMINI_STUDENT_API_KEY=your_student_gemini_api_key
